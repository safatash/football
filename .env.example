# Copy to .env and fill in. Never commit .env.

# Database (Neon Postgres). Use a branch/dev database for local work.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# NextAuth: generate with `openssl rand -base64 32`
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Leagues are found by host: <slug>.APP_ROOT_DOMAIN (e.g. nvasa.app.localhost:3000), or a league's
# custom domain. League-office access comes from each league's members (Settings › League office).
APP_ROOT_DOMAIN="app.localhost"
# Scheme and port of the root domain, for links in emails and Stripe (league URLs add the slug)
APP_ROOT_URL="http://app.localhost:3000"
# Sign-in redirects follow the league's host (Vercel sets this automatically)
AUTH_TRUST_HOST="true"
# The product name: emails go out as "{League} via {APP_NAME}"
APP_NAME="LeagueOffice"
# League logo uploads (Vercel Blob). Without it, admins paste a logo link instead.
BLOB_READ_WRITE_TOKEN=""
# Local work on plain localhost: the league to show (also ?org=<slug>). Ignored in production
# unless ALLOW_ORG_FALLBACK=true.
ORG_SLUG="nvasa"
ALLOW_ORG_FALLBACK=""

# Stripe (test keys locally). The webhook secret comes from `stripe listen` or the dashboard.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Cron routes (/api/cron/*) require `Authorization: Bearer $CRON_SECRET`. Vercel Cron sends it.
CRON_SECRET=""

# Email (SMTP). Production sends when these are set. Elsewhere mail is only logged unless
# MAIL_DELIVER=true, and then only to example.com / .test addresses or MAIL_TEST_RECIPIENTS.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="LeagueOffice <mail@example.com>"
MAIL_DELIVER=""
MAIL_TEST_RECIPIENTS=""

# Optional: view the app as of another moment (leave unset in production), e.g. the seeded week:
# NVASA_NOW="2026-05-16T12:00:00-04:00"

