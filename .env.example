# Copy to .env and fill in. Never commit .env.

# Database (Neon Postgres). Use a branch/dev database for local work.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# NextAuth: generate with `openssl rand -base64 32`
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# League office access: comma-separated emails (plus anyone with role ADMIN)
ADMIN_EMAILS="safatash@gmail.com"

# Stripe (test keys locally). The webhook secret comes from `stripe listen` or the dashboard.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Cron routes (/api/cron/*) require `Authorization: Bearer $CRON_SECRET`. Vercel Cron sends it.
CRON_SECRET=""

# Email (SMTP). Production sends when these are set. Elsewhere mail is only logged unless
# MAIL_DELIVER=true, and then only to example.com / .test addresses or MAIL_TEST_RECIPIENTS.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="NVASA <office@nvasa.org>"
MAIL_DELIVER=""
MAIL_TEST_RECIPIENTS=""

# Optional: view the app as of another moment (leave unset in production), e.g. the seeded week:
# NVASA_NOW="2026-05-16T12:00:00-04:00"

# Legacy import (scripts/import-legacy.ts): the old site's MySQL server, no database name
# (each season is its own database). LEGACY_WWWROOT is the old site folder, read only, for images.
LEGACY_MYSQL_URL=""
LEGACY_WWWROOT=""
