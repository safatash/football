// NVASA Database Schema
// Maps the existing ColdFusion database to Prisma models

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// CORE USER & AUTH MODELS
// ============================================

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String // Will be bcrypt hashed (currently plaintext in CF)
  role      Role     @default(PLAYER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One-to-one relationship with Player profile
  players Player[] // one profile per league

  paymentsRecorded Payment[]  @relation("PaymentRecordedBy")
  auditEntries     AuditLog[]

  isPlatformAdmin Boolean              @default(false) // the SaaS operator (not a league role)
  memberships     OrganizationMember[]

  // Auth.js required fields
  accounts Account[]
  sessions Session[]

  @@map("users")
}

enum Role {
  PLAYER
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================
// PLAYER PROFILE
// ============================================

model Player {
  id             String       @id @default(cuid())
  organizationId String       @default("org_nvasa") // owning league; the default is removed once the scoped client sets it
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Personal Information
  firstName String
  lastName  String
  gender    Gender
  dob       DateTime // Date of birth
  phone     String

  // Address
  address String
  city    String
  state   String
  zip     String
  county  String? // county of the home address (from the ZIP), used by county eligibility

  emergencyContactName  String?
  emergencyContactPhone String?

  // Soccer Info
  position   String
  tshirtSize String

  // Photo
  photoId  String?
  photo    String? // File path or URL
  photoUrl String? // shown publicly only when `social` is true

  /// Stable key from the old site (email, or legacy id when there's no email)
  legacyKey String?

  // Registration Status
  finalApproval ApprovalStatus @default(NEEDS_REVIEW)
  status        PlayerStatus   @default(ACTIVE)

  // Preferences
  contactMe   Boolean @default(false)
  social      Boolean @default(false) // Show on social media
  tournaments Boolean @default(false) // Interested in tournaments

  // Discount/Payment Codes
  boardMemberCode  String? // bm - board member discount
  discountCode     String? // dc - promotional discount
  teamPaidFullCode String? // pf - team paid in full code

  // Timestamps
  registrationDate DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relationships
  teamMemberships TeamRoster[]
  registrations   Registration[]
  gamePasses      GamePass[]
  payments        Payment[]
  matchStats      PlayerMatchStat[]
  captainRequests CaptainRequest[]
  suspensions     Suspension[]

  @@unique([userId, organizationId]) // one profile per person per league
  @@unique([organizationId, legacyKey])
  @@unique([id, organizationId])
  @@index([organizationId])
  @@map("players")
}

enum Gender {
  MALE
  FEMALE
  NON_BINARY
}

enum ApprovalStatus {
  PENDING
  APPROVED
  NEEDS_REVIEW
  REJECTED
}

enum PlayerStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

// ============================================
// SEASON & LEAGUE STRUCTURE
// ============================================

model Season {
  id               String       @id @default(cuid())
  organizationId   String       @default("org_nvasa") // owning league; the default is removed once the scoped client sets it
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name             String // e.g., "Fall 2024"
  slug             String // URL form, e.g. "spring-2026"
  /// The old site's per-season MySQL database name, e.g. "spring2026"
  legacyDatasource String?
  startDate        DateTime
  endDate          DateTime
  isActive         Boolean      @default(false) // Only one season should be active

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  divisions     Division[]
  teams         Team[]
  matches       Match[]
  registrations Registration[]
  discountCodes DiscountCode[]
  settings      LeagueSettings?

  @@unique([organizationId, name])
  @@unique([organizationId, slug])
  @@unique([organizationId, legacyDatasource])
  @@unique([id, organizationId])
  @@index([organizationId])
  @@map("seasons")
}

model Division {
  id             String       @id @default(cuid())
  organizationId String       @default("org_nvasa") // owning league; the default is removed once the scoped client sets it
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  seasonId       String
  season         Season       @relation(fields: [seasonId, organizationId], references: [id, organizationId], onDelete: Cascade)

  code            String // short code used in URLs, e.g. "wp"
  name            String
  description     String?
  level           String? // e.g. "Competitive", "Recreational"
  registrationFee Decimal        @default(0) @db.Decimal(10, 2)
  gamePassFee     Decimal?       @db.Decimal(10, 2) // overrides LeagueSettings.gamePassFee when set
  status          DivisionStatus @default(ACTIVE) // inactive divisions are hidden from registration and game passes

  // Default referee pay per role (a match can override it per official)
  centerRefFee    Decimal? @db.Decimal(10, 2)
  assistantRefFee Decimal? @db.Decimal(10, 2)
  fourthRefFee    Decimal? @db.Decimal(10, 2)

  maxTeams  Int? // creating teams past this is refused
  rosterMin Int? // roster sizes outside min/max show as warnings
  rosterMax Int?

  // Eligibility. Everyone must be at least minAge on the season's opening day (Season.startDate)
  // and born on or before the cutoff for their gender. Non-binary players use the male cutoff
  // and may only register for COED divisions.
  genderRule           GenderRule @default(COED)
  maleBornOnOrBefore   DateTime?  @db.Date
  femaleBornOnOrBefore DateTime?  @db.Date
  minAge               Int        @default(18)

  displayOrder Int  @default(0)
  legacyId     Int? // divisions.id in the old site's season database

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  teams         Team[]
  teamRosters   TeamRoster[]
  matches       Match[]
  registrations Registration[]

  @@unique([seasonId, name])
  @@unique([seasonId, code])
  @@unique([seasonId, legacyId])
  @@unique([id, organizationId])
  @@index([organizationId])
  @@map("divisions")
}

enum GenderRule {
  WOMEN
  MEN
  COED
}

model Team {
  id             String       @id @default(cuid())
  organizationId String       @default("org_nvasa") // owning league; the default is removed once the scoped client sets it
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  seasonId       String
  season         Season       @relation(fields: [seasonId, organizationId], references: [id, organizationId], onDelete: Cascade)
  divisionId     String
  division       Division     @relation(fields: [divisionId, organizationId], references: [id, organizationId])

  code      String? // short code, unique per season, e.g. "ffx"
  name      String
  shortName String? // crest abbreviation, e.g. "FU"
  color     String? // crest color, hex
  homeField String?
  status    TeamStatus @default(ACTIVE)
  isDemo    Boolean    @default(false) // sample team from the seed; shown as "Demo" and removable in Settings

  // Public team page
  logoUrl    String?
  photoUrl   String?
  homeShirt  String? // kit colors, hex
  homeShorts String?
  awayShirt  String?
  awayShorts String?
  formation  String?
  legacyId   Int? // teamdiv.id in the old site's season database

  // Team paid in full code
  paidInFullCode String? // pf code for free registration

  maxPlayers Int @default(20) // Team capacity

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  roster                 TeamRoster[]
  homeMatches            Match[]          @relation("HomeTeam")
  awayMatches            Match[]          @relation("AwayTeam")
  gamePasses             GamePass[]
  matchRosters           MatchRoster[]
  matchReports           MatchReport[]
  captainRequests        CaptainRequest[]
  discountCodes          DiscountCode[]
  preferredRegistrations Registration[]   @relation("PreferredTeam")
  backupRegistrations    Registration[]   @relation("BackupTeam")

  @@unique([seasonId, divisionId, name])
  @@unique([seasonId, name]) // team names are unique within a season
  @@unique([seasonId, code])
  @@unique([seasonId, legacyId])
  @@unique([organizationId, paidInFullCode])
  @@unique([id, organizationId])
  @@index([divisionId])
  @@index([organizationId])
  @@map("teams")
}

enum DivisionStatus {
  ACTIVE
  INACTIVE
}

enum TeamStatus {
  ACTIVE
  INACTIVE
  FULL
}

// ============================================
// TEAM ROSTERS & MEMBERSHIPS
// ============================================

model TeamRoster {
  id             String       @id @default(cuid())
  organizationId String       @default("org_nvasa") // owning league; the default is removed once the scoped client sets it
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  playerId       String
  player         Player       @relation(fields: [playerId, organizationId], references: [id, organizationId], onDelete: Cascade)
  teamId         String
  team           Team         @relation(fields: [teamId, organizationId], references: [id, organizationId], onDelete: Cascade)
  divisionId     String
  division       Division     @relation(fields: [divisionId, organizationId], references: [id, organizationId])

  // Membership Type
  membershipType MembershipType @default(SEASONAL)

  // Game Pass reference (if single-match)
  gamePassId String?   @unique
  gamePass   GamePass? @relation(fields: [gamePassId], references: [id])
  matchId    String? // Which match this applies to
  match      Match?    @relation(fields: [matchId], references: [id])

  // Captain Request
  captainRequest Boolean @default(false) // capreq
  isCaptain      Boolean @default(false) // Approved captain status

  jerseyNumber Int?

  // Lineup Management
  availability AvailabilityStatus @default(AVAILABLE)
  lineupStatus LineupStatus       @default(BENCH)

  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  matchAvailability  MatchAvailability[]
  matchRosterEntries MatchRosterEntry[]

  @@unique([playerId, teamId, membershipType, matchId])
  @@unique([id, organizationId])
  @@index([teamId, leftAt])
  @@index([matchId])
  @@index([organizationId])
  @@map("team_rosters")
}

enum MembershipType {
  SEASONAL // Full season membership
  GAME_PASS // Single match only
}

enum AvailabilityStatus {
  AVAILABLE
  UNAVAILABLE
  MAYBE
}

enum LineupStatus {
  STARTING
  BENCH
  INACTIVE
}

// ============================================
// REGISTRATION SYSTEM
// ============================================

model Registration {
  id             String       @id @default(cuid())
  organizationId String       @default("org_nvasa") // owning league; the default is removed once the scoped client sets it
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  playerId       String
  player         Player       @relation(fields: [playerId, organizationId], references: [id, organizationId], onDelete: Cascade)
  seasonId       String
  season         Season       @relation(fields: [seasonId, organizationId], references: [id, organizationId], onDelete: Cascade)

  // Registration Type
  registrationType RegistrationType @default(NEW_PLAYER)

  divisionId      String?
  division        Division? @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  preferredTeamId String?
  preferredTeam   Team?     @relation("PreferredTeam", fields: [preferredTeamId], references: [id], onDelete: SetNull)
  backupTeamId    String?
  backupTeam      Team?     @relation("BackupTeam", fields: [backupTeamId], references: [id], onDelete: SetNull)

  number Int @default(autoincrement()) // shown as "R-2041"

  background  PlayerBackground @default(NEW)
  level       String? // self-reported playing level
  captainNote String?
  playerNote  String? // anything the player told us, shown in placement

  // Legacy: JSON arrays of team names/ids from the first version of the wizard
  selectedTeams   String  @default("[]")
  captainRequests String?

  // Status: Submitted → Pending review (paid or free) → Approved / Denied
  status         RegistrationStatus @default(SUBMITTED)
  paymentStatus  PaymentStatus      @default(UNPAID)
  placementState PlacementState     @default(NONE)
  deniedReason   String? // internal reason
  deniedMessage  String? // message sent to the player

  // Payment Info
  amountBeforeDiscount Decimal?      @db.Decimal(10, 2)
  totalAmount          Decimal       @db.Decimal(10, 2)
  discountCodeId       String?
  discountCode         DiscountCode? @relation(fields: [discountCodeId], references: [id], onDelete: SetNull)
  paymentId            String?       @unique
  payment              Payment?      @relation(fields: [paymentId], references: [id])

  createdByAdminId String? // set when the league office created it (Add player)

  waiverAcceptedAt DateTime? // when the player accepted the league waiver

  submittedAt DateTime  @default(now())
  approvedAt  DateTime?
  rejectedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  captainRequestRows CaptainRequest[]

  @@unique([organizationId, number])
  @@index([seasonId, status])
  @@index([playerId])
  @@index([placementState])
  @@index([organizationId])
  @@map("registrations")
}

enum PlayerBackground {
  NEW
  RETURNING
}

enum PlacementState {
  NONE
  NEW
  INFO_REQUESTED
  WAITLISTED
  ASSIGNED
}

enum RegistrationType {
  NEW_PLAYER
  RETURNING_PLAYER
  ADDITIONAL_TEAM
}

enum RegistrationStatus {
  SUBMITTED
  PENDING // pending review
  APPROVED
  REJECTED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL // registration only: some of the balance paid
  PAID
  WAIVED // the league office waived (comped) the balance
  REFUNDED
  FAILED
}

enum PaymentMethod {
  CASH
  CHECK
  ZELLE
  VENMO
  CARD_IN_PERSON
  STRIPE
  OTHER
}

// ============================================
// GAME PASS SYSTEM
// ============================================

model GamePass {
  id             String       @id @default(cuid())
  organizationId String       @default("org_nvasa") // owning league; the default is removed once the scoped client sets it
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  playerId       String
  player         Player       @relation(fields: [playerId, organizationId], references: [id, organizationId], onDelete: Cascade)
  matchId        String
  match          Match        @relation(fields: [matchId, organizationId], references: [id, organizationId])
  teamId         String?
  team           Team?        @relation(fields: [teamId], references: [id])

  // Payment
  paymentId String  @unique
  payment   Payment @relation(fields: [paymentId, organizationId], references: [id, organizationId])

  // Status
  status GamePassStatus @default(ACTIVE)

  // Validity
  validFrom  DateTime
  validUntil DateTime
  usedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One-to-one with TeamRoster
  teamRoster TeamRoster?

  @@unique([playerId, matchId])
  @@unique([paymentId, organizationId])
  @@index([matchId, status])
  @@index([status, validUntil])
  @@index([organizationId])
  @@map("game_passes")
}

enum GamePassStatus {
  ACTIVE
  USED
  EXPIRED
  CANCELLED
}

// ============================================
// MATCHES & SCHEDULING
// ============================================

model Match {
  id             String       @id @default(cuid())
  organizationId String       @default("org_nvasa") // owning league; the default is removed once the scoped client sets it
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  seasonId       String
  season         Season       @relation(fields: [seasonId, organizationId], references: [id, organizationId], onDelete: Cascade)
  divisionId     String?
  division       Division?    @relation(fields: [divisionId], references: [id], onDelete: SetNull)

  gameNumber Int // shown as "Game #204", unique per season

  homeTeamId String
  homeTeam   Team   @relation("HomeTeam", fields: [homeTeamId, organizationId], references: [id, organizationId])
  awayTeamId String
  awayTeam   Team   @relation("AwayTeam", fields: [awayTeamId, organizationId], references: [id, organizationId])

  scheduledAt DateTime
  startTime   DateTime?
  endTime     DateTime?

  field    String?
  location String?
  fieldId  String?
  venue    Field?  @relation(fields: [fieldId], references: [id], onDelete: SetNull)
  legacyId Int? // schedule.id in the old site's season database

  // Scores
  homeScore Int?
  awayScore Int?

  status MatchStatus @default(SCHEDULED)

  // Aggregate of the two team reports, kept in sync by the report actions
  reportStatus ReportStatus @default(NOT_STARTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  gamePasses   GamePass[]
  teamRosters  TeamRoster[] // Game pass players for this match
  availability MatchAvailability[]
  matchRosters MatchRoster[]
  reports      MatchReport[]
  officials    MatchOfficial[]

  @@unique([seasonId, gameNumber])
  @@unique([seasonId, legacyId])
  @@unique([id, organizationId])
  @@index([seasonId, scheduledAt])
  @@index([fieldId])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@index([organizationId])
  @@map("matches")
}

enum ReportStatus {
  NOT_STARTED
  DRAFT
  SUBMITTED
  CONFIRMED
  OVERDUE
}

// ============================================
// MATCH DAY: AVAILABILITY, MATCH ROSTERS, REPORTS
// ============================================

model MatchAvailability {
  id             String             @id @default(cuid())
  organizationId String             @default("org_nvasa") // owning league; the default is removed once the scoped client sets it
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  matchId        String
  match          Match              @relation(fields: [matchId, organizationId], references: [id, organizationId], onDelete: Cascade)
  teamRosterId   String
  teamRoster     TeamRoster         @relation(fields: [teamRosterId, organizationId], references: [id, organizationId], onDelete: Cascade)
  status         AvailabilityStatus
  note           String?
  updatedById    String? // user who set it (the player or a captain)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([matchId, teamRosterId])
  @@index([teamRosterId])
  @@index([organizationId])
  @@map("match_availability")
}

model MatchRoster {
  id             String            @id @default(cuid())
  organizationId String            @default("org_nvasa") // owning league; the default is removed once the scoped client sets it
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  matchId        String
  match          Match             @relation(fields: [matchId, organizationId], references: [id, organizationId], onDelete: Cascade)
  teamId         String
  team           Team              @relation(fields: [teamId, organizationId], references: [id, organizationId], onDelete: Cascade)
  status         MatchRosterStatus @default(DRAFT)
  formation      String? // e.g. "4-4-2"
  finalizedAt    DateTime?
  finalizedById  String?

  entries MatchRosterEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([matchId, teamId])
  @@unique([id, organizationId])
  @@index([teamId])
  @@index([organizationId])
  @@map("match_rosters")
}

enum MatchRosterStatus {
  DRAFT
  FINALIZED
}

model MatchRosterEntry {
  id             String       @id @default(cuid())
  organizationId String       @default("org_nvasa") // owning league; the default is removed once the scoped client sets it
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  matchRosterId  String
  matchRoster    MatchRoster  @relation(fields: [matchRosterId, organizationId], references: [id, organizationId], onDelete: Cascade)
  teamRosterId   String
  teamRoster     TeamRoster   @relation(fields: [teamRosterId, organizationId], references: [id, organizationId], onDelete: Cascade)
  lineupSlot     String? // e.g. "GK", "LCB"; null = bench

  @@unique([matchRosterId, teamRosterId])
  @@unique([matchRosterId, lineupSlot])
  @@index([teamRosterId])
  @@index([organizationId])
  @@map("match_roster_entries")
}

model MatchReport {
  id             String       @id @default(cuid())
  organizationId String       @default("org_nvasa") // owning league; the default is removed once the scoped client sets it
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  matchId        String
  match          Match        @relation(fields: [matchId, organizationId], references: [id, organizationId], onDelete: Cascade)
  teamId         String // the reporting team
  team           Team         @relation(fields: [teamId, organizationId], references: [id, organizationId], onDelete: Cascade)
  homeScore      Int?
  awayScore      Int?
  redCardNote    String?
  status         ReportStatus @default(DRAFT)
  submittedById  String?
  submittedAt    DateTime?
  confirmedById  String?
  confirmedAt    DateTime?

  stats PlayerMatchStat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([matchId, teamId])
  @@unique([id, organizationId])
  @@index([teamId])
  @@index([status])
  @@index([organizationId])
  @@map("match_reports")
}

model PlayerMatchStat {
  id             String       @id @default(cuid())
  organizationId String       @default("org_nvasa") // owning league; the default is removed once the scoped client sets it
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  reportId       String
  report         MatchReport  @relation(fields: [reportId, organizationId], references: [id, organizationId], onDelete: Cascade)
  playerId       String
  player         Player       @relation(fields: [playerId, organizationId], references: [id, organizationId], onDelete: Cascade)
  goals          Int          @default(0)
  assists        Int          @default(0)
  yellow         Int          @default(0)
  secondYellow   Int          @default(0)
  red            Int          @default(0)
  inGame         InGame       @default(IN)
  note           String?

  @@unique([reportId, playerId])
  @@index([playerId])
  @@index([organizationId])
  @@map("player_match_stats")
}

enum InGame {
  IN // started
  OUT // came on as a sub
  DNP // didn't play
}

/// A playing field. Matches point here for directions on public pages.
/// A park or complex. The address lives here once; its fields are the playing surfaces.
model Park {
  id             String       @id @default(cuid())
  organizationId String       @default("org_nvasa") // owning league; the default is removed once the scoped client sets it
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String // e.g. "Wakefield Park"
  address        String? // street
  city           String?
  state          String? // VA / MD / DC
  zip            String?
  mapUrl         String? // optional map link; otherwise one is built from the address
  notes          String? // parking and directions, shown to players
  isDemo         Boolean      @default(false) // sample park from the seed; removed by Settings › Demo data

  fields Field[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@unique([id, organizationId])
  @@index([organizationId])
  @@map("parks")
}

model Field {
  id             String       @id @default(cuid())
  organizationId String       @default("org_nvasa") // owning league; the default is removed once the scoped client sets it
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  parkId         String
  park           Park         @relation(fields: [parkId, organizationId], references: [id, organizationId])
  name           String // field within the park, e.g. "3" or "North"
  surface        FieldSurface @default(GRASS)
  lights         Boolean      @default(false)
  size           FieldSize    @default(FULL)
  active         Boolean      @default(true) // inactive fields are hidden when scheduling
  notes          String?
  legacyId       Int? // fields.id in the old site (shared across seasons)

  matches Match[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([parkId, name])
  @@unique([organizationId, legacyId])
  @@index([organizationId])
  @@map("fields")
}

enum FieldSurface {
  GRASS
  TURF
}

enum FieldSize {
  FULL
  SMALL_SIDED
}

// ============================================
// CAPTAINS & DISCIPLINE
// ============================================

model CaptainRequest {
  id             String               @id @default(cuid())
  organizationId String               @default("org_nvasa") // owning league; the default is removed once the scoped client sets it
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  playerId       String
  player         Player               @relation(fields: [playerId, organizationId], references: [id, organizationId], onDelete: Cascade)
  teamId         String
  team           Team                 @relation(fields: [teamId, organizationId], references: [id, organizationId], onDelete: Cascade)
  registrationId String?
  registration   Registration?        @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  note           String?
  status         CaptainRequestStatus @default(PENDING)
  decidedById    String?
  decidedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([playerId])
  @@index([teamId])
  @@index([organizationId])
  @@map("captain_requests")
}

enum CaptainRequestStatus {
  PENDING
  APPROVED
  DENIED
}

/// A player is suspended while a suspension is active (startsAt <= now, endsAt null or in the
/// future, not lifted). Player.status is kept in sync by the suspend / lift actions.
model Suspension {
  id             String       @id @default(cuid())
  organizationId String       @default("org_nvasa") // owning league; the default is removed once the scoped client sets it
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  playerId       String
  player         Player       @relation(fields: [playerId, organizationId], references: [id, organizationId], onDelete: Cascade)
  reason         String
  startsAt       DateTime     @default(now())
  endsAt         DateTime?
  liftedAt       DateTime?
  createdById    String?

  createdAt DateTime @default(now())

  @@index([playerId, endsAt])
  @@index([organizationId])
  @@map("suspensions")
}

// ============================================
// FEES, DISCOUNTS & SETTINGS
// ============================================

model DiscountCode {
  id             String       @id @default(cuid())
  organizationId String       @default("org_nvasa") // owning league; the default is removed once the scoped client sets it
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  code           String // stored uppercase
  kind           DiscountKind
  type           DiscountType
  value          Decimal      @db.Decimal(10, 2) // percent (0-100) or dollars
  maxUses        Int?
  uses           Int          @default(0)
  active         Boolean      @default(true)
  seasonId       String
  season         Season       @relation(fields: [seasonId, organizationId], references: [id, organizationId], onDelete: Cascade)
  teamId         String? // TEAM_PAID codes only work for this team
  team           Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)

  registrations Registration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, code])
  @@index([seasonId])
  @@index([organizationId])
  @@map("discount_codes")
}

enum DiscountKind {
  BOARD
  PROMO
  TEAM_PAID
}

enum DiscountType {
  PERCENT
  AMOUNT
}

model LeagueSettings {
  id             String       @id @default(cuid())
  organizationId String       @default("org_nvasa") // owning league; the default is removed once the scoped client sets it
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  seasonId       String       @unique
  season         Season       @relation(fields: [seasonId, organizationId], references: [id, organizationId], onDelete: Cascade)
  gamePassFee    Decimal?     @db.Decimal(10, 2) // overrides OrganizationSettings for this season
  maxMatchRoster Int? // overrides OrganizationSettings for this season

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([seasonId, organizationId])
  @@index([organizationId])
  @@map("league_settings")
}

enum MatchStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  POSTPONED
}

// ============================================
// PAYMENTS
// ============================================

model Payment {
  id             String       @id @default(cuid())
  organizationId String       @default("org_nvasa") // owning league; the default is removed once the scoped client sets it
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userId         String

  // Stripe IDs
  stripePaymentIntentId String? @unique
  stripeChargeId        String? @unique

  amount      Decimal       @db.Decimal(10, 2)
  currency    String        @default("usd")
  status      PaymentStatus @default(UNPAID)
  paymentType PaymentType

  // What this payment is for
  relatedEntityType String? // "registration", "game_pass"
  relatedEntityId   String? // ID of the registration or game pass

  // Legacy Authorize.Net support
  authorizeNetTransactionId String? // TransactionID from old system

  // Recorded by the league office (Stripe payments come from the webhook). Payments are never
  // deleted: corrections are new rows (refunds, waivers).
  method           PaymentMethod?
  reference        String? // check number or transaction id
  notes            String?
  recordedByUserId String?
  recordedBy       User?          @relation("PaymentRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relationships
  player       Player        @relation(fields: [userId, organizationId], references: [id, organizationId])
  registration Registration?
  gamePass     GamePass?

  @@unique([id, organizationId])
  @@index([organizationId])
  @@map("payments")
}

enum PaymentType {
  REGISTRATION_FEE
  GAME_PASS
  REFUND
  WAIVER // balance waived; no money moved
}

// ============================================
// BLOCKLIST (Security)
// ============================================

model Blocklist {
  id             String       @id @default(cuid())
  organizationId String       @default("org_nvasa") // owning league; the default is removed once the scoped client sets it
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  email          String
  reason         String?
  blockedAt      DateTime     @default(now())
  blockedBy      String? // Admin who blocked them

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("blocklist")
}

// ============================================
// GEOGRAPHIC RESTRICTIONS
// ============================================

model AllowedZipCode {
  id             String       @id @default(cuid())
  organizationId String       @default("org_nvasa") // owning league; the default is removed once the scoped client sets it
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  zipCode        String
  city           String?
  state          String?
  county         String? // county the ZIP is in; null = an extra ZIP allowed on its own

  @@unique([organizationId, zipCode])
  @@index([organizationId])
  @@map("allowed_zip_codes")
}

// ============================================
// REFERENCE DATA
// ============================================

model Position {
  id             String       @id @default(cuid())
  organizationId String       @default("org_nvasa") // owning league; the default is removed once the scoped client sets it
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String
  category       String? // Defender, Midfielder, Forward, Goalkeeper

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("positions")
}

model TshirtSize {
  id             String       @id @default(cuid())
  organizationId String       @default("org_nvasa") // owning league; the default is removed once the scoped client sets it
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  size           String
  displayOrder   Int          @default(0)

  @@unique([organizationId, size])
  @@index([organizationId])
  @@map("tshirt_sizes")
}

/// What the league office did, for billing and other admin actions. Rows are never edited.
model AuditLog {
  id             String       @id @default(cuid())
  organizationId String       @default("org_nvasa") // owning league; the default is removed once the scoped client sets it
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actorUserId    String?
  actor          User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorEmail     String // kept even if the account is deleted
  action         String // e.g. "payment.recorded", "payment.refunded", "player.created"
  entityType     String // "registration", "player", "payment"
  entityId       String
  summary        String // one line for people, e.g. "Recorded $50 check #1042"
  data           Json?
  createdAt      DateTime     @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([organizationId])
  @@map("audit_log")
}

/// A match official. Referees don't have accounts; the office assigns them.
model Referee {
  id             String            @id @default(cuid())
  organizationId String            @default("org_nvasa") // owning league; the default is removed once the scoped client sets it
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String
  email          String?
  phone          String?
  certLevel      String? // e.g. "USSF Grade 8"
  certExpires    DateTime?         @db.Date
  positions      RefereePosition[] @default([CENTER, ASSISTANT])
  active         Boolean           @default(true) // inactive referees can't be assigned
  notes          String?
  isDemo         Boolean           @default(false) // sample referee from the seed; removed by Settings › Demo data

  assignments MatchOfficial[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, organizationId])
  @@index([name])
  @@index([organizationId])
  @@map("referees")
}

enum RefereePosition {
  CENTER
  ASSISTANT
}

enum OfficialRole {
  CENTER
  AR1
  AR2
  FOURTH
}

enum OfficialStatus {
  ASSIGNED
  CONFIRMED
  DECLINED
  NO_SHOW
}

/// One referee in one role on one match, with their pay.
model MatchOfficial {
  id             String         @id @default(cuid())
  organizationId String         @default("org_nvasa") // owning league; the default is removed once the scoped client sets it
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  matchId        String
  match          Match          @relation(fields: [matchId, organizationId], references: [id, organizationId], onDelete: Cascade)
  refereeId      String
  referee        Referee        @relation(fields: [refereeId, organizationId], references: [id, organizationId])
  role           OfficialRole
  status         OfficialStatus @default(ASSIGNED)
  fee            Decimal?       @db.Decimal(10, 2) // overrides the division's fee for this role
  paidAt         DateTime? // set when the office marks the fee paid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([matchId, role])
  @@index([refereeId])
  @@index([organizationId])
  @@map("match_officials")
}

/// A league using the app (NVASA is the first). Everything league-owned has an organizationId.
model Organization {
  id           String             @id @default(cuid())
  name         String
  slug         String             @unique // subdomain: <slug>.<APP_ROOT_DOMAIN>
  customDomain String?            @unique // e.g. nvasa.org
  logoUrl      String?
  primaryColor String? // hex; falls back to the app's green
  accentColor  String?
  timezone     String             @default("America/New_York")
  contactEmail String?
  supportEmail String?
  status       OrganizationStatus @default(TRIAL)
  plan         String             @default("pilot")
  trialEndsAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  OrganizationMember[]
  settings OrganizationSettings?

  players            Player[]
  seasons            Season[]
  divisions          Division[]
  teams              Team[]
  teamRosters        TeamRoster[]
  registrations      Registration[]
  gamePasses         GamePass[]
  matches            Match[]
  matchAvailability  MatchAvailability[]
  matchRosters       MatchRoster[]
  matchRosterEntries MatchRosterEntry[]
  matchReports       MatchReport[]
  playerMatchStats   PlayerMatchStat[]
  parks              Park[]
  fields             Field[]
  captainRequests    CaptainRequest[]
  suspensions        Suspension[]
  discountCodes      DiscountCode[]
  leagueSettings     LeagueSettings[]
  payments           Payment[]
  blocklist          Blocklist[]
  allowedZipCodes    AllowedZipCode[]
  positions          Position[]
  tshirtSizes        TshirtSize[]
  auditLog           AuditLog[]
  referees           Referee[]
  matchOfficials     MatchOfficial[]

  @@map("organizations")
}

enum OrganizationStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

/// A user's role in one league. Being an admin in one league gives nothing in another.
model OrganizationMember {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           OrgRole      @default(PLAYER)
  status         MemberStatus @default(ACTIVE)
  invitedAt      DateTime?
  joinedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("organization_members")
}

enum OrgRole {
  OWNER
  ADMIN
  STAFF
  PLAYER
}

enum MemberStatus {
  INVITED
  ACTIVE
  REMOVED
}

/// League-wide settings. Seasons can override some of them in LeagueSettings.
model OrganizationSettings {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  gamePassesEnabled Boolean @default(true)
  gamePassFee       Decimal @default(15) @db.Decimal(10, 2)
  maxMatchRoster    Int     @default(18)

  pointsWin   Int          @default(3)
  pointsDraw  Int          @default(1)
  pointsLoss  Int          @default(0)
  tieBreakers TieBreaker[] @default([GOAL_DIFFERENCE, GOALS_FOR])

  eligibilityMode  EligibilityMode @default(NONE)
  eligibleCounties String[]        @default([]) // e.g. ["Fairfax County, VA"] for COUNTY_LIST

  waiverText     String?
  waiverRequired Boolean @default(true)

  registrationOpen Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("organization_settings")
}

enum TieBreaker {
  GOAL_DIFFERENCE
  GOALS_FOR
  HEAD_TO_HEAD
  FEWEST_GOALS_AGAINST
}

enum EligibilityMode {
  NONE // anyone can register
  ZIP_LIST // only ZIPs in the allowed list
  COUNTY_LIST // addresses in the listed counties, plus any extra ZIPs in the list
}
